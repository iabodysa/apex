# Three groups, one purpose each, in this order on purpose: git applies the LAST
# matching pattern, so the publication allowlist has to sit below the denials it
# inverts. Moving a group changes what a fresh clone contains.


# ---- 1. Build residue -------------------------------------------------------
# Written by a build, a test run, a package step or the OS. Never authored here.

__pycache__/
*.pyc
*.egg-info
build/
dist/
# A wheel built outside dist/ needs its own rule: an unignored stray wheel joins any
# tree mirrored with `git ls-files --cached --others --exclude-standard`, which a
# fresh clone never holds.
*.whl
node_modules
tags

# macOS junk (also stripped by: apex.sh clean)
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
__MACOSX
.fseventsd


# ---- 2. Local developer files -----------------------------------------------
# This working copy only. None of it is part of the app, and none of it ships.

# Agent and bench tooling working directories. The owner's scanners live under
# .claude/ by decision, so this one line already covers them.
.claude/
.agents/
.codex/
.trae/
.frappectl/
.frappectl.toml
skills-lock.json
# Symlink to the bench control tool, which lives outside this checkout.
ctl
.ctl/
.ctl.toml

# A nested checkout — worktree or vendored clone — is never this repo's content.
**/.git/

# Local-only rich demo generator: Arabic sample data, bench-only, never published.
apex/demo/

# Dead code archive.
archive/

# Local-only scratch scripts and reports.
scratch/
*.command
*.applescript
flash_actions_report.json

# Raw HTTP/curl response dumps — may capture live auth tokens.
curl_output*.txt
**/curl_output*.txt
*.curl

# Environment, secrets, and local runtime files.
.env
.env.*
*.local
*.secret
*secret*
*.key
*.pem

# Editor swap files.
*.swp


# ---- 3. Publication rules ---------------------------------------------------

# Private office source files — the app ships no spreadsheet.
*.xlsx
*.xls
*.xlsm
*.csv
*.numbers
*.ods
# Arabic belongs in the translation CSV, and only there, so it is the one .csv
# that ships.
!apex/translations/
!apex/translations/*.csv
# Local ratchet state for the translation audit; it is tooling data, not app content.
apex/translations/*.stale-baseline.txt

# Markdown outside the documentation tree stays private by default.
*.md
# Deliberately NOT anchored to the repo root: matching README.md at every depth is
# what keeps apex/change_log/README.md (the in-app changelog index) and the
# frontend package READMEs shipping. Rewriting this as `!/README.md` drops them.
!README.md
# The portal design guide ships with the workspace it governs: a builder working from a
# clone has to be able to read the tokens, the scales and the archetypes.
!frontend/frontend_shared/DESIGN.md
# Frappe's "Updated To A New Version" popup reads these as shipped app files.
!apex/change_log/v*/*.md

# Documentation is a first-class project tree. New public guides, diagrams and
# assets under docs/ are tracked without editing this file or using git add -f.
# Internal execution plans remain under .claude/ and stay local.
!docs/
!docs/**

# Unlocking docs does not publish credentials or private key material.
docs/**/.env*
docs/**/*.secret
docs/**/*secret*
docs/**/*.key
docs/**/*.pem
.vite/
