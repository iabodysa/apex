.DS_Store
__pycache__/
*.pyc
**/.git/
*.egg-info
*.swp
tags
node_modules

# Local working context (never commit).
.claude/
.agents/
.codex/
.trae/
.frappectl/
.frappectl.toml
skills-lock.json
ctl
.ctl/
.ctl.toml


# Internal project documents and source spreadsheets.
docs/
*.md
!README.md
# Frappe "Updated To A New Version" popup changelogs are shipped app files.
!apex/change_log/v*/*.md
# Public developer integration guide — ONLY this one file under docs/ is published
# (docs/superpowers and all other docs/ content stay ignored).
!docs/
docs/*
!docs/INTEGRATION.md
!docs/TRAINING.md
# Operator upgrade runbook: the supported pre-rename app-identity cutover path.
!docs/UPGRADE-APP-IDENTITY.md
!docs/WORKSPACE-DESIGN.md
# Public per-area training guide (index + one file per functional area)
!docs/training/
!docs/training/*.md

# Local-only rich demo generator — Arabic sample data, bench-only, never published
apex/demo/

# Local/private office source files.
*.xlsx
*.xls
*.xlsm
*.csv
*.numbers
*.ods

# Translation CSV files are publishable because Arabic text belongs there.
!apex/translations/
!apex/translations/*.csv

# Environment, secrets, and local runtime files.
.env
.env.*
*.local
*.secret
*secret*
*.key
*.pem

# Build and packaging outputs.
# (*.egg-info is covered once, above.)
build/
dist/

# Dead code archive.
archive/

# Local-only scratch scripts and reports (never commit).
scratch/
*.command
*.applescript
flash_actions_report.json

# Raw HTTP/curl response dumps — may capture live auth tokens; never commit.
curl_output*.txt
**/curl_output*.txt
*.curl

# macOS junk (also stripped by: apex.sh clean)
._*
.AppleDouble
.Spotlight-V100
.Trashes
__MACOSX
.fseventsd
