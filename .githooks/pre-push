#!/bin/sh
# The last gate before anything becomes public.
#
# Install (one line, from the repo root):
#     git config core.hooksPath .githooks
#
# commit-msg and pre-commit each refuse a bad commit while it is still being made.
# They cannot see a commit created with --no-verify, or one made before the hooks
# were installed on this clone - and by push time such a commit is already history.
# So this hook re-runs BOTH of them over every outgoing commit. It re-runs them, it
# does not reimplement them: the attribution rule and the address allowlist are both
# declared once, in .claude/tools/scripts/check_commit_metadata.py, which those two hooks
# invoke. That is what keeps this gate honest when either rule changes.
#
# The scanners and the metadata gate are the maintainer's own tooling and are NOT
# published with the app, so no CI lane runs them any more. This hook is the last and
# only gate before anything becomes public, which is why every branch below refuses
# rather than warns: a missing runner now means the guards did not run, and a push that
# proceeds on that basis is indistinguishable from a clean one.
set -eu

hookdir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(git rev-parse --show-toplevel)

message_file=$(mktemp)
# A refusal must not leave the temp message behind: it holds the very text the gate
# exists to keep out of sight.
trap 'rm -f "$message_file"' EXIT INT TERM

# Git signals "no such object" with an all-zero sha, whose width follows the repo's
# hash algorithm - so test the shape, not a hardcoded string of zeros.
all_zero() {
	case "$1" in
	"") return 1 ;;
	*[!0]*) return 1 ;;
	*) return 0 ;;
	esac
}

check_commit() {
	sha="$1"

	git log -1 --format=%B "$sha" >"$message_file"
	if ! "$hookdir/commit-msg" "$message_file"; then
		echo "pre-push: refused by commit-msg above, in commit $sha" >&2
		return 1
	fi

	author=$(git log -1 --format=%ae "$sha")
	committer=$(git log -1 --format=%ce "$sha")
	if ! "$hookdir/pre-commit" "$author" "$committer"; then
		echo "pre-push: refused by pre-commit above, in commit $sha" >&2
		return 1
	fi
}

# $1 is a git-log revision spec that may carry several words ("<sha> --not
# --remotes=origin"), so it is deliberately left unquoted where git expands it.
scan_range() {
	shas=$(git log --format=%H $1)

	failed=0
	for sha in $shas; do
		check_commit "$sha" || failed=1
	done
	[ "$failed" -eq 0 ] || return 1

	# The scanners live behind the shared runner. This used to degrade to a WARNING when
	# the runner was absent, and the push went through: the one branch where nothing was
	# scanned printed a line to stderr and then read, to anyone glancing at the output,
	# exactly like a clean scan. Moving the runner out of the published tree turned that
	# rare branch into the DEFAULT for every clone that lacks it, so it is now a refusal.
	# There is no CI lane behind this to catch what slips past.
	guards="$root/.claude/tools/scripts/run_guards.sh"
	if [ ! -x "$guards" ]; then
		echo "pre-push: $guards is missing or not executable, so the content and secret" >&2
		echo "pre-push: guards DID NOT RUN. Refusing the push rather than reporting an" >&2
		echo "pre-push: unscanned range as clean - no CI lane re-checks this." >&2
		return 1
	fi
	"$guards" range "$1"
	"$guards" tree
}

while read -r _local_ref local_sha _remote_ref remote_sha; do
	# A deletion pushes an all-zero local sha and adds no content to scan.
	if all_zero "$local_sha"; then
		continue
	fi
	if all_zero "$remote_sha"; then
		# A branch the remote has never seen: everything not already published.
		scan_range "$local_sha --not --remotes=origin"
	else
		scan_range "$remote_sha..$local_sha"
	fi
done
