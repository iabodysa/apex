#!/bin/sh
# Reject a private author or committer email before the commit exists.
#
# Install (one line, from the repo root):
#     git config core.hooksPath .githooks
#
# The allowlist is NOT written here. .claude/tools/scripts/check_commit_metadata.py holds
# it once, for this hook and for commit-msg; this file only decides WHICH two addresses
# get judged. That gate is unpublished maintainer tooling, so no CI lane can re-check it.
#
# `git commit --author=...` IS caught: git exports the resolved author identity to the
# hook, so `git var` reports the forced address, not the configured one. What no
# pre-commit hook can see is a commit created with --no-verify or before the hooks were
# installed; .githooks/pre-push re-checks the outgoing range for exactly that case.
set -u

hookdir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
gate="$hookdir/../.claude/tools/scripts/check_commit_metadata.py"

ident_email() {
	git var "$1" 2>/dev/null | sed -n 's/.*<\(.*\)>.*/\1/p'
}

# Given two addresses, classify THOSE instead of this machine's identity. git never
# passes arguments to pre-commit, so this lane belongs to pre-push, which reuses this
# hook over already-recorded commits rather than keeping a copy of the allowlist.
if [ "$#" -eq 2 ]; then
	author=$1
	committer=$2
else
	author=$(ident_email GIT_AUTHOR_IDENT)
	committer=$(ident_email GIT_COMMITTER_IDENT)
fi

# Fail closed, for the same reason commit-msg does.
if [ ! -f "$gate" ]; then
	echo "pre-commit: $gate is missing, so the commit metadata gate DID NOT RUN" >&2
	exit 1
fi
if ! command -v python3 >/dev/null 2>&1; then
	echo "pre-commit: python3 is required to run the commit metadata gate" >&2
	exit 1
fi

exec python3 "$gate" email "$author" "$committer"
