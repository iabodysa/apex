#!/bin/sh
# Reject a commit message that CI would reject, before the commit exists.
#
# Install (one line, from the repo root):
#     git config core.hooksPath .githooks
#
# The rule is NOT written here. .claude/tools/scripts/check_commit_metadata.py is its one
# definition. That file is the maintainer's own tooling and is not published with the
# app, so no CI lane can run it any more: this hook and pre-push are now the ONLY place
# the rule is enforced, which is why both fail closed rather than warn.
set -u

# Resolved against this hook, not against the work tree: core.hooksPath may point at
# another clone's .githooks, and then the work tree has no copy of the gate to run.
hookdir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
gate="$hookdir/../.claude/tools/scripts/check_commit_metadata.py"

# Fail closed. A missing gate or a missing interpreter must refuse the commit, never
# wave it through: a guard that silently stops running is worse than no guard.
if [ ! -f "$gate" ]; then
	echo "commit-msg: $gate is missing, so the commit metadata gate DID NOT RUN" >&2
	exit 1
fi
if ! command -v python3 >/dev/null 2>&1; then
	echo "commit-msg: python3 is required to run the commit metadata gate" >&2
	exit 1
fi

exec python3 "$gate" message "$1"
