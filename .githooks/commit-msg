#!/bin/sh
# Reject a commit message that CI would reject, before the commit exists.
#
# Install (one line, from the repo root):
#     git config core.hooksPath .githooks
#
# The rule is NOT written here. check_commit_metadata.py is its one definition, and it
# is the maintainer's tooling rather than part of the published app — so no CI lane can
# run it, and this hook is the only place it is enforced. That is why it fails closed.
#
# WHERE THE GATE COMES FROM, and why there are two places to look. It used to be
# resolved only at ../.claude/tools/scripts/, which .gitignore excludes — so a fresh
# clone that followed the install line above got a hook that refused EVERY commit,
# because the file it needed had never been cloned. The gate now also ships in the skill
# suite, which is installed on the machine rather than in the repository, and `ctl` on
# PATH is how that suite is found. Repo copy first, so a project that ships its own gate
# still wins; suite copy second; and if neither is present the refusal says which.
set -u

. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/_suite"
gate=$(suite_tool ".claude/tools/scripts/check_commit_metadata.py" "check_commit_metadata.py")

# Fail closed. A missing gate or a missing interpreter must refuse the commit, never
# wave it through: a guard that silently stops running is worse than no guard.
if [ -z "$gate" ]; then
	echo "commit-msg: the commit metadata gate DID NOT RUN, so this commit is refused." >&2
	suite_missing
	exit 1
fi
if ! command -v python3 >/dev/null 2>&1; then
	echo "commit-msg: python3 is required to run the commit metadata gate" >&2
	exit 1
fi

exec python3 "$gate" message "$1"
