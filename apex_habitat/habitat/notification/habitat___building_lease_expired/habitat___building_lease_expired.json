{
 "attach_print": 0,
 "channel": "Email",
 "condition": "doc.status == 'Active' and doc.lease_renewal_status != 'Terminated'",
 "date_changed": "lease_end_date",
 "days_in_advance": 0,
 "docstatus": 0,
 "doctype": "Notification",
 "document_type": "Accommodation Building",
 "enabled": 0,
 "event": "Days Before",
 "idx": 0,
 "is_standard": 1,
 "message": "{{ _(\"The lease for\") }} {{ doc.building_name }} {{ _(\"has ended\") }} ({{ doc.lease_end_date }}).",
 "message_type": "HTML",
 "module": "Habitat",
 "name": "Habitat - Building Lease Expired",
 "recipients": [
  {
   "receiver_by_role": "Accommodation Manager"
  },
  {
   "receiver_by_role": "System Manager"
  }
 ],
 "send_system_notification": 0,
 "send_to_all_assignees": 0,
 "subject": "Building Lease EXPIRED: {{ doc.building_name }}"
}
