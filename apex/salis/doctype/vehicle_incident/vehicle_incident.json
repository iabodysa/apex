 "fields": [
  {
   "fieldname": "vi_tab_overview",
   "fieldtype": "Tab Break",
   "label": "Overview"
  },
  {
   "fieldname": "vi_sec_incident",
   "fieldtype": "Section Break",
   "label": "Incident"
  },
  {
   "fieldname": "incident_type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Incident Type",
   "options": "Accident\nTheft",
   "reqd": 1
  },
  {
   "fieldname": "vehicle",
   "fieldtype": "Link",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Vehicle",
   "options": "Salis Vehicle",
   "reqd": 1,
   "search_index": 1
  },
  {
   "fieldname": "incident_date",
   "fieldtype": "Date",
   "in_list_view": 1,
   "label": "Incident Date",
   "reqd": 1
  },
  {
   "description": "Clock time of the incident. A police report and an insurer both ask for it, and it orders two incidents on the same day.",
   "fieldname": "incident_time",
   "fieldtype": "Time",
   "label": "Incident Time"
  },
  {
   "fieldname": "vi_incident_col",
   "fieldtype": "Column Break"
  },
  {
   "fetch_from": "vehicle.current_driver",
   "fetch_if_empty": 1,
   "fieldname": "driver",
   "fieldtype": "Link",
   "in_standard_filter": 1,
   "label": "Driver",
   "options": "Salis Driver",
   "search_index": 1
  },
  {
   "fieldname": "location",
   "fieldtype": "Data",
   "label": "Location"
  },
  {
   "fieldname": "report_number",
   "fieldtype": "Data",
   "label": "Police Report Number"
  },
  {
   "description": "Dashboard reading when the incident happened, which fixes the vehicle's mileage at the moment of loss.",
   "fieldname": "odometer_at_incident",
   "fieldtype": "Int",
   "label": "Odometer at the Incident"
  },
  {
   "fieldname": "vi_sec_details",
   "fieldtype": "Section Break",
   "label": "Details"
  },
  {
   "fieldname": "description",
   "fieldtype": "Text",
   "label": "Description",
   "reqd": 1
  },
  {
   "depends_on": "eval:doc.incident_type=='Accident'",
   "fieldname": "fault",
   "fieldtype": "Data",
   "label": "Fault / Liable Party"
  },
  {
   "depends_on": "eval:doc.incident_type=='Accident'",
   "fieldname": "damaged_parts",
   "fieldtype": "Small Text",
   "label": "Damaged Parts"
  },
  {
   "depends_on": "eval:doc.incident_type=='Accident'",
   "description": "Whether anybody was hurt. An insurer treats a bodily-injury accident under a different cover.",
   "fieldname": "injuries",
   "fieldtype": "Select",
   "label": "Injuries",
   "options": "\nNo Injuries\nMinor Injuries\nSerious Injuries\nFatality"
  },
  {
   "depends_on": "eval:doc.injuries && doc.injuries!='No Injuries'",
   "fieldname": "injury_details",
   "fieldtype": "Small Text",
   "label": "Injury Details"
  },
  {
   "fieldname": "vi_details_col",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "estimated_cost",
   "fieldtype": "Currency",
   "label": "Estimated Cost (SAR)"
  },
  {
   "fieldname": "reported_by",
   "fieldtype": "Data",
   "label": "Reported By"
  },
  {
   "fieldname": "vi_sec_evidence",
   "fieldtype": "Section Break",
   "label": "Evidence"
  },
  {
   "description": "Police report PDF or a photo of the scene.",
   "fieldname": "evidence",
   "fieldtype": "Attach",
   "label": "Evidence"
  },
  {
   "fieldname": "vi_sec_insurance",
   "fieldtype": "Section Break",
   "label": "Insurance"
  },
  {
   "description": "The policy in force on our vehicle on the day of the incident.",
   "fieldname": "policy_number",
   "fieldtype": "Data",
   "label": "Insurance Policy Number"
  },
  {
   "fieldname": "vi_insurance_col",
   "fieldtype": "Column Break"
  },
  {
   "description": "The claim the insurer opened against this incident.",
   "fieldname": "insurance_claim_number",
   "fieldtype": "Data",
   "label": "Insurance Claim Number"
  },
  {
   "fieldname": "vi_sec_third_party",
   "fieldtype": "Section Break",
   "label": "Third Party"
  },
  {
   "default": "0",
   "description": "Set when another vehicle or another person was part of the incident.",
   "fieldname": "third_party_involved",
   "fieldtype": "Check",
   "label": "Third Party Involved"
  },
  {
   "depends_on": "eval:doc.third_party_involved",
   "fieldname": "third_party_plate",
   "fieldtype": "Data",
   "label": "Third Party Plate Number"
  },
  {
   "depends_on": "eval:doc.third_party_involved",
   "fieldname": "third_party_driver",
   "fieldtype": "Data",
   "label": "Third Party Driver"
  },
  {
   "fieldname": "vi_third_party_col",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.third_party_involved",
   "fieldname": "third_party_insurer",
   "fieldtype": "Data",
   "label": "Third Party Insurer"
  },
  {
   "depends_on": "eval:doc.third_party_involved",
   "fieldname": "third_party_policy",
   "fieldtype": "Data",
   "label": "Third Party Policy Number"
  },
  {
   "fieldname": "vi_sec_disposition",
   "fieldtype": "Section Break",
   "label": "Disposition"
  },
  {
   "default": "Open",
   "description": "System-managed handling stage of the vehicle incident record.",
   "fieldname": "status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Status",
   "options": "Open\nUnder Review\nClosed",
   "read_only": 1
  },
  {
   "fieldname": "vi_disposition_col",
   "fieldtype": "Column Break"
  },
  {
   "description": "Set when the incident is escalated to a damage write-off.",
   "fieldname": "write_off_case",
   "fieldtype": "Link",
   "label": "Write-Off Case",
   "options": "Vehicle Damage Write-Off",
   "read_only": 1
  },
  {
   "fieldname": "vi_sec_recovery",
   "fieldtype": "Section Break",
   "label": "Cost Recovery from Driver"
  },
  {
   "default": "0",
   "description": "Recover the repair cost from the driver. On submit this raises one native Employee Advance; payroll installments remain off until Employee Advance Recovery is enabled in Salis Settings.",
   "fieldname": "recover_from_driver",
   "fieldtype": "Check",
   "label": "Recover Cost from Driver"
  },
  {
   "depends_on": "eval:doc.recover_from_driver",
   "description": "Employee the cost is recovered from. Fetched from the driver's employee record.",
   "fetch_from": "driver.employee",
   "fetch_if_empty": 1,
   "fieldname": "recovery_employee",
   "fieldtype": "Link",
   "label": "Recover From Employee",
   "mandatory_depends_on": "eval:doc.recover_from_driver",
   "options": "Employee"
  },
  {
   "depends_on": "eval:doc.recover_from_driver",
   "description": "Total amount to recover. Never more than the estimated cost.",
   "fieldname": "recovery_amount",
   "fieldtype": "Currency",
   "label": "Amount to Recover (SAR)",
   "mandatory_depends_on": "eval:doc.recover_from_driver",
   "non_negative": 1
  },
  {
   "depends_on": "eval:doc.recover_from_driver",
   "description": "Agreed amount to deduct per pay period. Leave blank to recover as fast as the statutory cap allows.",
   "fieldname": "installment_amount",
   "fieldtype": "Currency",
   "label": "Agreed Installment per Pay Period (SAR)",
   "non_negative": 1
  },
  {
   "fieldname": "vi_recovery_col",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.recover_from_driver",
   "description": "The worker's signed consent to the recovery. Required before the incident can be approved; KSA Labor Law requires the worker's consent for a wage deduction.",
   "fieldname": "worker_signature",
   "fieldtype": "Signature",
   "label": "Worker Consent Signature",
   "no_copy": 1,
   "permlevel": 1
  },
  {
   "depends_on": "eval:doc.recover_from_driver",
   "description": "Stamped when the consent signature is first recorded.",
   "fieldname": "signed_on",
   "fieldtype": "Date",
   "label": "Consent Signed On",
   "no_copy": 1,
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.recover_from_driver",
   "description": "The Employee Advance raised for this incident. One incident raises at most one advance; the company payment and the wage installments both run on it.",
   "fieldname": "recovery_advance",
   "fieldtype": "Link",
   "label": "Recovery Advance",
   "no_copy": 1,
   "options": "Employee Advance",
   "read_only": 1
  },
  {
   "collapsible": 1,
   "fieldname": "vi_sec_system",
   "fieldtype": "Section Break",
   "label": "System"
  },
  {
   "default": "VI-.######",
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "hidden": 1,
   "label": "Series",
   "options": "VI-.######",
   "reqd": 1
  },
  {
