# Template for e2e/.env.local (which is gitignored). Copy to e2e/.env.local and
# set a real value for SCREENSHOT_PW, then run the setup step (see desk_auth.py).
# The screenshot user is a synthetic, read-only Desk account on a DISPOSABLE site.
#
# SITE_NAME names that site explicitly and is sent as X-Frappe-Site-Name, which
# frappe/app.py prefers over the request host. One bench serves several sites here
# and they all answer on localhost, so leaving it unset lets the host decide which
# one a capture is pointed at - and a capture that lands on a site holding real
# records publishes them. Never point it at a site whose data is not synthetic.
BASE_URL=http://localhost:8000
SITE_NAME=change-me-disposable-site
SCREENSHOT_USER=screenshot-bot@apex.test
SCREENSHOT_PW=change-me-local-only
